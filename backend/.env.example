# Application
APP_NAME=TrinetraAI
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/trinetraai
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/trinetraai

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

#OpenAI
OPENAI_API_KEY=your_api_key
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1


# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./chroma_data

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/trinetraai.log

# Confidence Thresholds
INVESTIGATION_CONFIDENCE_THRESHOLD=0.75
MAX_INVESTIGATION_CYCLES=5

# Frontend URL (used for OAuth callback redirects)
FRONTEND_URL=http://localhost:5173

# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
# Google OAuth
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=your_callback_url

# Facebook OAuth
FACEBOOK_CLIENT_ID=your_client_id
FACEBOOK_CLIENT_SECRET=your_client_secret
FACEBOOK_CALLBACK_URL=your_callback_url

# GitHub OAuth
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
GITHUB_CALLBACK_URL=your_callback_url
